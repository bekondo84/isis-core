<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           targetNamespace="http://www.isis.cm/config/dashboard"
           xmlns:tns="http://www.isis.cm/config/dashboard">
    <xs:element name="dashbord">
        <xs:complexType>
            <xs:choice minOccurs="1" maxOccurs="unbounded">
                <xs:element name="charts" type="tns:Charts"  />
                <xs:element name="kpiCards" type="tns:KpiCards" />
                <xs:element name="workflowKpiCards" type="tns:WorflowKpiCards" />
            </xs:choice>
            <xs:attribute name="action" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="AbstractDashboardSection">
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="position" type="xs:unsignedInt" default="100"/>
        <xs:attribute name="columns"  type="xs:unsignedInt" default="3" />
        <xs:attribute name="header"  type="xs:boolean" default="false" />
    </xs:complexType>
    <!--Kpi cards  -->
    <xs:complexType name="KpiCards">
        <xs:complexContent>
            <xs:extension base="tns:AbstractDashboardSection">
                <xs:sequence>
                    <xs:element name="items" type="tns:CardItem" minOccurs="1" maxOccurs="unbounded" />
                </xs:sequence>
                <xs:attribute name="action" use="required"  type="xs:string"/>
                <xs:attribute name="method" use="required"  type="xs:string" />
                <xs:attribute name="refresh" type="xs:integer"  default="3600"/>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- Workflows Kpi Cards -->
    <xs:complexType name="WorflowKpiCards">
        <xs:complexContent>
            <xs:extension base="tns:AbstractDashboardSection">
                <xs:sequence>
                    <xs:element name="items" type="tns:CardItem" minOccurs="1" maxOccurs="unbounded" />
                </xs:sequence>
                <xs:attribute name="icon" type="xs:string" />
                <xs:attribute name="unit" type="xs:string" />
                <xs:attribute name="action" use="required"  type="xs:string"/>
                <xs:attribute name="method" use="required"  type="xs:string" />
                <xs:attribute name="refresh" type="xs:integer"  default="3600"/>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- General section contain Pie, bar and other diagramme-->
    <xs:complexType name="Charts">
        <xs:complexContent>
            <xs:extension base="tns:AbstractDashboardSection">
                <xs:choice minOccurs="1" maxOccurs="unbounded">
                    <xs:element name="barChart" type="tns:BarChart" />
                    <xs:element name="pieChart" type="tns:PieChart" />
                    <xs:element name="doughnutChart" type="tns:DoughnutChart" />
                    <xs:element name="lineChart" type="tns:LineChart" />
                    <xs:element name="activityLogs" type="tns:ActivityLogs" />
                </xs:choice>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="AbstractDashboardItem">
        <xs:attribute name="id" type="xs:string" use="required" />
        <xs:attribute name="color" type="xs:string" />
        <xs:attribute name="icon" type="xs:string" />
    </xs:complexType>
    <xs:complexType name="CardItem">
        <xs:complexContent>
            <xs:extension base="tns:AbstractDashboardItem">
               <xs:attribute name="currency" type="xs:string" />
                <!-- the color of the text -->
                <xs:attribute name="text" type="xs:string" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="ChartItem">
       <xs:complexContent>
           <xs:extension base="tns:AbstractDashboardItem">
               <xs:attribute name="action" type="xs:string" use="required"/>
               <xs:attribute name="method" type="xs:string" use="required"/>
               <xs:attribute name="refresh" type="xs:integer"  default="3600"/>
           </xs:extension>
       </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="BarChart">
        <xs:complexContent>
            <xs:extension base="tns:ChartItem">
                <xs:attribute name="bgColor" type="xs:string" default="#9333ea"/>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="LineChart">
        <xs:complexContent>
            <xs:extension base="tns:BarChart">
                <xs:attribute name="pointBgColor" type="xs:string" default="#9333ea"/>
                <xs:attribute name="borderColor" type="xs:string" default="#9333ea" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="DoughnutChart">
        <xs:complexContent>
            <xs:extension base="tns:ChartItem">

            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="PieChart">
        <xs:complexContent>
            <xs:extension base="tns:ChartItem">

            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="ActivityLogs">
        <xs:complexContent>
            <xs:extension base="tns:ChartItem">

            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:simpleType name="ChartType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="bar" />
            <xs:enumeration value="doughnut" />
            <xs:enumeration value="line" />
            <xs:enumeration value="pie" />
            <xs:enumeration value="radar" />
            <xs:enumeration value="scatter" />
            <xs:enumeration value="activitylogs" />
        </xs:restriction>
    </xs:simpleType>
</xs:schema>