<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           targetNamespace="http://www.isis.cm/config/dashboard"
           xmlns:tns="http://www.isis.cm/config/dashboard">
    <xs:element name="dashbord">
        <xs:complexType>
            <xs:choice>
                <xs:element name="charts" type="tns:Charts" minOccurs="0" maxOccurs="unbounded" />
                <xs:element name="kpiCards" type="tns:KpiCards" minOccurs="0" maxOccurs="unbounded" />
                <xs:element name="workflowKpiCards" type="tns:WorflowKpiCards" minOccurs="0" maxOccurs="unbounded" />
            </xs:choice>
            <xs:attribute name="action" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="AbstractDashboardSection">
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="position" type="xs:unsignedInt" default="100"/>
        <xs:attribute name="columns"  type="xs:unsignedInt" />
        <xs:attribute name="header"  type="xs:boolean" default="false" />
    </xs:complexType>
    <!--Kpi cards  -->
    <xs:complexType name="KpiCards">
        <xs:complexContent>
            <xs:extension base="tns:AbstractDashboardSection">
                <xs:sequence>
                    <xs:element name="items" type="tns:CardItem" minOccurs="1" maxOccurs="unbounded" />
                </xs:sequence>
                <xs:attribute name="action" use="required"  type="xs:string"/>
                <xs:attribute name="method" use="required"  type="xs:string" />
                <xs:attribute name="refresh" type="xs:integer"  default="3600"/>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- Workflows Kpi Cards -->
    <xs:complexType name="WorflowKpiCards">
        <xs:complexContent>
            <xs:extension base="tns:AbstractDashboardSection">
                <xs:sequence>
                    <xs:element name="items" type="tns:CardItem" minOccurs="1" maxOccurs="unbounded" />
                </xs:sequence>
                <xs:attribute name="action" use="required"  type="xs:string"/>
                <xs:attribute name="method" use="required"  type="xs:string" />
                <xs:attribute name="refresh" type="xs:integer"  default="3600"/>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- General section contain Pie, bar and other diagramme-->
    <xs:complexType name="Charts">
        <xs:complexContent>
            <xs:extension base="tns:AbstractDashboardSection">
                <xs:sequence>
                    <xs:element name="items" type="tns:ChartItem" minOccurs="1" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="CardItem">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>
    <xs:complexType name="ChartItem">
       <xs:complexContent>
           <xs:extension base="tns:CardItem">
               <xs:attribute name="action" type="xs:string" use="required"/>
               <xs:attribute name="method" type="xs:string" use="required"/>
               <xs:attribute name="type" type="tns:ChartType" use="required"/>
               <xs:attribute name="refresh" type="xs:integer"  default="3600"/>
           </xs:extension>
       </xs:complexContent>
    </xs:complexType>
    <xs:simpleType name="ChartType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="pie" />
            <xs:enumeration value="line" />
            <xs:enumeration value="doughnut" />
            <xs:enumeration value="bar" />
        </xs:restriction>
    </xs:simpleType>
</xs:schema>