<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.isis.cm/config/isis-color"
           xmlns:tns="http://www.isis.cm/config/isis-color"
           elementFormDefault="qualified">

    <!--  <xs:element name="color" type="tns:colorType"> </xs:element>
         Create context type represented configuration of item -->
    <xs:simpleType name="colorType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="danger" />
            <xs:enumeration value="primary" />
            <xs:enumeration value="green" />
            <xs:enumeration value="success" />
            <xs:enumeration value="blue" />
            <xs:enumeration value="info" />
            <xs:enumeration value="orange" />
            <xs:enumeration value="warning" />
            <xs:enumeration value="red" />
            <xs:enumeration value="purple" />
        </xs:restriction>
    </xs:simpleType>
</xs:schema>