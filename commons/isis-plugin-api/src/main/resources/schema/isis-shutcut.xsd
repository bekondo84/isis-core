<?xml version="1.0" encoding="UTF-8" ?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://www.isis.cm/config/isis-shutcut"
        xmlns:tns="http://www.isis.cm/config/isis-shutcut"
        xmlns:utils="http://www.isis.cm/config/isis-utils"
        elementFormDefault="qualified">
    <import namespace="http://www.isis.cm/config/isis-utils" schemaLocation="isis-utils.xsd" />

    <element name="shutcuts" type="tns:shutcuts" />
    <complexType name="shutcuts">
        <sequence>
            <element name="shutcut" type="tns:shutcut" minOccurs="0" maxOccurs="unbounded" />
        </sequence>
    </complexType>
    <complexType name="shutcut">
        <sequence>
            <element name="filters" type="tns:filters" minOccurs="0" maxOccurs="1" />
        </sequence>

        <attribute name="code" type="string" />
        <attribute name="icon" type="string" default="" />
        <attribute name="type" type="string" />
        <attribute name="viewMode" type="utils:viewModeType" default="list,view" />
    </complexType>

    <complexType name="filters">
        <sequence>
            <element name="filter" type="tns:filter" minOccurs="1" maxOccurs="unbounded"/>
        </sequence>
    </complexType>
    <complexType name="filter">
        <attribute name="source" type="string" use="required" />
        <attribute name="target"  type="string" use="required" />
        <attribute name="operator" type="utils:operatorType" use="required"/>
        <attribute name="nature" type="tns:targetValue"  use="required" />
        <attribute name="type"  type="utils:valueType" use="required" />
    </complexType>
    <simpleType name="targetValue">
        <restriction base="string">
            <enumeration value="field" />
            <enumeration value="value" />
        </restriction>
    </simpleType>
</schema>