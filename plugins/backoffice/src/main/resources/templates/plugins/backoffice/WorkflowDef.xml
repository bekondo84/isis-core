<?xml version="1.0" encoding="UTF-8" ?>
<context xmlns="http://www.isis.cm/config/isis-template"
     xmlns:l="http://www.isis.cm/config/list-view"
     xmlns:a="http://www.isis.cm/config/editor-area">
    <l:list-view>
        <l:list>
            <l:column qualifier="id" search="true" />
            <l:column qualifier="name" search="true" />
            <l:column qualifier="version" search="true" />
            <l:column qualifier="executable" widget="switch" search="true"/>
            <l:column qualifier="template"  search="true" />
            <l:column qualifier="createdAt" widget="datetime-local" />
            <l:column qualifier="lastModif" widget="datetime-local" />
        </l:list>
    </l:list-view>
    <a:editor-area delete="false" update="false" create="false" createOnField="false">
        <a:component>
            <a:common>
                <a:form>
                    <a:section name="commons.section" position="100" columns="2">
                        <a:field qualifier="id" />
                        <a:field qualifier="name" />
                        <a:field qualifier="version" />
                        <a:field qualifier="executable" widget="switch" />
                        <a:field qualifier="template" />
                        <a:field qualifier="createdAt" widget="datetime-local" />
                        <a:field qualifier="lastModif" widget="datetime-local" />
                    </a:section>
                </a:form>
            </a:common>
        </a:component>
    </a:editor-area>
</context>